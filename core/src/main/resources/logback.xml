<configuration>
    <!-- INFO: SQL Exposed (DEBUG) содержит тексты напоминаний — их нельзя писать в лог (.claude/rules/security.md). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX, UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="Exposed" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.modelcontextprotocol" level="WARN"/>
    <logger name="FeatureRegistry" level="WARN"/>

    <root level="${THESEUS_LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
