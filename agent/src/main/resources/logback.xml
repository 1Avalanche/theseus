<configuration>
    <!-- INFO: тексты сообщений пользователей и ответы модели в лог не пишутся (.claude/rules/security.md). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX, UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.ktor" level="WARN"/>
    <logger name="io.modelcontextprotocol" level="WARN"/>
    <logger name="KSLog" level="WARN"/>

    <root level="${THESEUS_LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
