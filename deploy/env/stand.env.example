# Конфиг стенда. На VPS: /opt/theseus/<стенд>/stand.env, права 600, владелец root.
# В git — только этот шаблон. Значения TODO предоставляет владелец (docs/operations.md, «Что нужно от владельца»).
# Комментарии — только отдельными строками.

# --- Стенд: prod | test (для test/stand.env — test) ---
THESEUS_STAND=prod
# Registry фиксируется в root-owned config.json; образы задаёт обработчик по digest.

# --- Память (DECISIONS.md §1, §12): prod — heap 256m / лимит 400m, test — 128m / 300m ---
THESEUS_CORE_HEAP=256m
THESEUS_AGENT_HEAP=256m
THESEUS_CORE_MEM_LIMIT=400m
THESEUS_AGENT_MEM_LIMIT=400m

# --- Секреты ---
# Пароль роли theseus_<стенд>_core: тот же, что THESEUS_<СТЕНД>_CORE_DB_PASSWORD в infra.env
THESEUS_CORE_DB_PASSWORD=TODO
# openssl rand -hex 32; свой на каждый стенд
THESEUS_SERVICE_TOKEN=TODO
# BotFather; у prod и test разные боты
THESEUS_TELEGRAM_BOT_TOKEN=TODO
# Один ключ OpenRouter на оба стенда
THESEUS_OPENROUTER_API_KEY=TODO

# --- Админ (этап 2: единственный пользователь, без онбординга) ---
# chatId владельца в Telegram (число)
THESEUS_ADMIN_CHAT_ID=TODO
THESEUS_ADMIN_NAME=TODO
# male | female | unspecified
THESEUS_ADMIN_GENDER=unspecified
# IANA-таймзона
THESEUS_ADMIN_TIMEZONE=Europe/Moscow

# --- LLM: модели роли main в порядке приоритета (fallback OpenRouter) ---
THESEUS_LLM_MAIN_MODELS=anthropic/claude-haiku-5.5,google/gemini-3.1-flash-lite,openai/gpt-5.4-nano

# --- Необязательные ---
# THESEUS_DEFAULT_TIME=09:00
