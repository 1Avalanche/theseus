# На VPS: /opt/theseus/monitor.env, root:root, 600. URL пульса — секреты.
# Внешний сервис должен принимать POST: отдельный URL успеха и URL отказа.
# Ожидаемый период — 10 минут; допустимая задержка — 10 минут.
# Например, два URL одного check: ping URL и ping URL /fail.
THESEUS_MONITOR_HEARTBEAT_URL=https://heartbeat.example/SECRET
THESEUS_MONITOR_FAILURE_URL=https://heartbeat.example/SECRET/fail

# Необязательный отдельный бот оповещений. Задаются вместе; не использовать токен Сири.
# THESEUS_MONITOR_BOT_TOKEN=TODO
# THESEUS_MONITOR_CHAT_ID=TODO

# Все файловые системы с данными; пути разделяются запятыми.
THESEUS_MONITOR_DISK_PATHS=/,/opt/theseus,/var/lib/docker

# Включить после запуска ночного бэкапа. Файл содержит Unix timestamp успешного завершения.
# THESEUS_MONITOR_BACKUP_SUCCESS_FILE=/opt/theseus/backups/last-success
